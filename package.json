{
  "name": "rockin-local-ai-cockpit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "\u003e=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build --workspaces --if-present",
    "e2e": "playwright test",
    "dev:web": "npm run dev --workspace @rockin/web",
    "dev:server": "npm run dev --workspace @rockin/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean-room": "node scripts/clean-room-scan.mjs",
    "license:audit": "node scripts/license-audit.mjs",
    "verify": "npm run format:check \u0026\u0026 npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build \u0026\u0026 npm run e2e \u0026\u0026 npm audit --audit-level=high \u0026\u0026 npm run license:audit \u0026\u0026 npm run clean-room"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "systeminformation": "^5.33.10",
    "three": "^0.180.0"
  },
  "type": "module"
}
